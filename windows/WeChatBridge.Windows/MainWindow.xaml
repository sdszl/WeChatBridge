<Window x:Class="WeChatBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信流 · WeChatBridge"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="560"
        Background="#F5F7FA"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="微信流 · WeChatBridge"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#1B1F24" />
            <TextBlock Margin="0,8,0,0"
                       Text="把微信导出的聊天归档保存到本地，并生成 Obsidian Markdown 笔记。"
                       FontSize="15"
                       Foreground="#5C6670" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,16"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="1 · 选择微信归档"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,14"
                           Text="可以选择 ZIP 文件或包含导出文件的文件夹，也可以直接拖到窗口。"
                           Foreground="#65707A" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SelectFilesButton"
                            Content="选择 ZIP 文件"
                            Click="SelectFiles_Click" />
                    <Button x:Name="SelectFolderButton"
                            Content="选择文件夹"
                            Click="SelectFolder_Click" />
                    <Button x:Name="ClearButton"
                            Content="清空"
                            Click="Clear_Click" />
                </StackPanel>
                <ListBox x:Name="InputList"
                         Margin="0,14,0,0"
                         MinHeight="92"
                         MaxHeight="170"
                         BorderBrush="#DCE2E8" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="2 · 归档设置"
                           FontSize="17"
                           FontWeight="SemiBold" />

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Obsidian 知识库" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="VaultTextBox" MinWidth="520" />
                        <Button Content="选择…" Click="ChooseVault_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="笔记子文件夹" />
                    <TextBox x:Name="SubfolderTextBox" Grid.Column="1" Text="微信流" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="聊天名称（可选）" />
                    <TextBox x:Name="ChatNameTextBox" Grid.Column="1" />
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExportButton"
                                Content="导入并生成 Markdown"
                                Background="#1769E0"
                                Foreground="White"
                                Click="Export_Click" />
                        <Button x:Name="OpenButton"
                                Content="打开知识库"
                                Click="OpenVault_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="ExportProgress"
                                 Margin="0,16,0,0"
                                 Height="6"
                                 IsIndeterminate="False" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="#59636D" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   Text="本地收件箱：%LOCALAPPDATA%\\WeChatBridge\\Inbox · 当前版本不会读取或修改微信数据库。"
                   Foreground="#78838D"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
